# ─────────────────────────────────────────────────────────────────────────
# mcp-ki-kb-fs — environment template.
# Copy to `.env.development` for local `bun run server:mcp:dev` (NODE_ENV=development),
# or to `.env.local` (loaded in every mode), or set these in your MCP client's
# `env` block. See README.md for full setup. `.env.*` files are gitignored; only
# `.env*.example` templates are committed.
# ─────────────────────────────────────────────────────────────────────────

# The knowledge bases this server may reach: a JSON object mapping the
# caller-facing alias to the base's absolute (or ~/...) path. Required.
#
# This declaration is the install's authorisation boundary. A base that is not
# declared here is unreachable — every tool takes a required `kb` argument whose
# value must be one of these aliases, and no argument can introduce a path. All
# tool paths are confined under the selected base's root; any input resolving
# outside it (traversal or symlink escape, including into a sibling declared
# base) is rejected.
#
# Validated in full at startup: malformed JSON, a repeated alias, an alias that
# is not a safe identifier, a relative path, or a path that is not an existing
# directory each abort the server rather than surfacing on a later call.
MCP_KI_KB_FS_KNOWLEDGE_BASES={"kit-pkb":"~/your-kb","kit-legal":"~/another-kb"}

# ─────────────────────────────────────────────────────────────────────────
# Access level & audit log — conventions shared across all HNR MCP servers.
# ─────────────────────────────────────────────────────────────────────────

# Maximum access level to register at server boot. One of: read, write,
# destructive. Levels nest: `read` registers only read-only tools; `write`
# adds non-destructive mutations; `destructive` adds delete/overwrite tools.
# A tool's level is derived from its MCP annotations (readOnlyHint /
# destructiveHint), not its name — see src/utils/access-level.ts.
# Default: read.
# MCP_KI_KB_FS_ACCESS_LEVEL=destructive

# Audit log of tool invocations, written as JSONL. One of: off, writes, all.
#   off    — no audit logging
#   writes — record write/destructive calls only (default)
#   all    — record every call, including reads
# MCP_KI_KB_FS_AUDIT_LOG=writes

# Path to the audit log file.
# MCP_KI_KB_FS_AUDIT_LOG_PATH=~/.local/state/mcp-ki-kb-fs/audit.jsonl

# Rotate the audit log when it exceeds this many bytes (0 disables rotation).
# Default: 10485760 (10 MiB).
# MCP_KI_KB_FS_AUDIT_LOG_MAX_BYTES=10485760

# Number of rotated audit logs to keep. Default: 5.
# MCP_KI_KB_FS_AUDIT_LOG_KEEP=5
